#!/bin/sh
# Run sprite on the panel in place of the tty1 login, and put the login back when it exits.
# Run as root (prototype: the builtin seat backend; apps themselves run as the 'of' user).
# Log: /run/sprite.log
systemctl stop getty@tty1 2>/dev/null
export LIBSEAT_BACKEND=builtin WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
export XDG_RUNTIME_DIR=/run/sprite
export PATH=/opt/sprite/bin:$PATH
/opt/sprite/bin/sprite > /run/sprite.log 2>&1
status=$?
systemctl start getty@tty1
exit $status
