# make-strings.awk: Sprite's on-screen text, from src/strings/en_gb.txt (and another language's file
# after it, if one's given), as build/gen/sprite_strings.h: a #define STR_<KEY> "text" for each message,
# so the code has them as string literals and the compiler checks every printf-style use
# against its placeholders. The helper's reasons (helper.*) are a table as well, strings_helper[],
# for a key that comes from sprite-helper at run time (in the file that defines
# SPRITE_STRINGS_HELPER before including it).
#   awk -f scripts/make-strings.awk src/strings/en_gb.txt [src/strings/en_us.txt] > build/gen/sprite_strings.h
#
# It stops (exit 1, saying where) on a line that isn't "key = text", a key used twice, a
# backslash other than \n, or empty text. A second file may only change messages the first
# has, and must keep each one's placeholders (%s, %d, ...), in order.

function fail(msg) { printf "%s:%d: %s\n", FILENAME, FNR, msg > "/dev/stderr"; bad = 1; exit 1 }
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
# Its placeholders, in order (%% isn't one).
function holes(s,   out, m) {
	out = ""
	while (match(s, /%[-+ #0]*[0-9*]*(\.[0-9*]+)?(hh|h|ll|l|z|j|t|L)?[diouxXeEfFgGcsp%]/)) {
		m = substr(s, RSTART, RLENGTH)
		if (m != "%%") out = out " " m
		s = substr(s, RSTART + RLENGTH)
	}
	return out
}

FNR == 1 { file++ }
/^[ \t]*(#|$)/ { next }
{
	i = index($0, "=")
	if (!i) fail("not \"key = text\"")
	key = trim(substr($0, 1, i - 1))
	text = trim(substr($0, i + 1))
	if (key !~ /^[a-z0-9_]+(\.[a-z0-9_]+)*$/) fail("\"" key "\" isn't a key (lower case, digits, _ and .)")
	if (text == "") fail(key ": no text")
	if (text ~ /\\[^n]|\\$/) fail(key ": the only backslash allowed is \\n")
	if (file == 1) {
		if (key in t) fail(key ": already given")
		order[++n] = key
	} else {
		if (!(key in t)) fail(key ": not in " first ", so the code doesn't use it")
		if (key in changed) fail(key ": already given")
		if (holes(text) != holes(t[key])) fail(key ": its placeholders (" holes(text) " ) aren't " first "'s (" holes(t[key]) " )")
		changed[key] = 1
	}
	if (file == 1) first = FILENAME
	t[key] = text
}

END {
	if (bad) exit 1
	print "/* Generated by scripts/make-strings.awk from src/strings: edit those files, not this. */"
	print "#ifndef SPRITE_STRINGS_H"
	print "#define SPRITE_STRINGS_H"
	for (k = 1; k <= n; k++) {
		key = order[k]
		name = toupper(key); gsub(/\./, "_", name)
		s = t[key]; gsub(/"/, "\\\"", s)
		printf "#define STR_%s \"%s\"\n", name, s
	}
	print "#ifdef SPRITE_STRINGS_HELPER"
	print "static const struct { const char *key, *text; } strings_helper[] = {"
	for (k = 1; k <= n; k++) {
		key = order[k]
		if (key !~ /^helper\./) continue
		s = t[key]; gsub(/"/, "\\\"", s)
		printf "\t{ \"%s\", \"%s\" },\n", key, s
	}
	print "};"
	print "#endif"
	print "#endif"
}
